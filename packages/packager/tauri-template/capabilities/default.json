{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Default capability granting safe baseline permissions to the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-title",
    "core:webview:allow-internal-toggle-devtools",
    "allow-qa-bridge-start",
    "allow-qa-bridge-stop",
    "allow-qa-bridge-push"
  ]
}
