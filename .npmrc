# The Atelier pipeline is VENDORED under packages/, which makes those packages
# workspace members — and pnpm installs a workspace member's optional peer
# dependencies unless told not to. forge declares two: a 35 MB ffmpeg build and
# a 20 MB texture encoder, neither of which a game without audio or textures
# ever runs. Measured: 595 MB → 534 MB on a workspace holding one empty game.
#
# Install them per-workspace when you need them:
#   pnpm add -D -w @ffmpeg-installer/ffmpeg   # audio encoding
#   pnpm add -D -w @gpu-tex-enc/basis         # KTX2 / Basis textures
auto-install-peers=false
